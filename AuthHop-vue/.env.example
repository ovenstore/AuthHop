# Shared by AuthHop-vue and AuthHop-demo (same Supabase project)

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# AuthHop portal origin (used by the demo site for redirects)
VITE_AUTHHOP_URL=http://localhost:5173

# Demo site origin (used by AuthHop when building authorize links / allowlist)
VITE_DEMO_URL=http://localhost:5174

# Relying-party site id stored on SSO + auth history rows
VITE_DEMO_SITE_ID=demo-app
